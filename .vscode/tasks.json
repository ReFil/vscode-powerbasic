{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Extension: Build VSIX Package",
            "type": "shell",
            "command": "npx",
            "args": [
                "vsce",
                "package"
            ],
            "problemMatcher": [
                "$eslint-stylish"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Extension: Install Dependencies",
            "type": "shell",
            "command": "npm",
            "args": [
                "install"
            ],
            "problemMatcher": [],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Extension: Run in VS Code (Debug)",
            "type": "shell",
            "command": "code",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}"
            ],
            "problemMatcher": [],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }
    ]
}
